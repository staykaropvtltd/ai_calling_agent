# ============================================================
# STAYKARO AI CALLER — Production Environment Template
# ============================================================
# On VPS:
#   cp .env.production.example /opt/staykaro/.env
#   nano /opt/staykaro/.env   ← fill every CHANGE_ME value
#
# Generate secrets:
#   openssl rand -hex 32     →  64-char hex (use for keys)
#   openssl rand -base64 32  →  base64 string
#
# NEVER commit this file's real values.
# NEVER use development defaults in production.
# ============================================================

# ── Project ──────────────────────────────────────────────────
PROJECT_NAME=StaykaroAICaller
ENVIRONMENT=production
LOG_LEVEL=warning

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres          # Docker service name — internal only
POSTGRES_PORT=5432
POSTGRES_DB=staykaro_prod
POSTGRES_USER=staykaro_user
POSTGRES_PASSWORD=CHANGE_ME     # openssl rand -hex 32
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis                # Docker service name — internal only
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME        # openssl rand -hex 32  ← REQUIRED in prod
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ── API Service ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
API_SECRET_KEY=CHANGE_ME        # openssl rand -hex 32

# ── JWT Auth ─────────────────────────────────────────────────
# Different from API_SECRET_KEY — rotated independently.
JWT_SECRET_KEY=CHANGE_ME        # openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── External: Bland AI ───────────────────────────────────────
BLAND_API_KEY=CHANGE_ME

# ── Voice Gateway ────────────────────────────────────────────
VOICE_GATEWAY_HOST=0.0.0.0
VOICE_GATEWAY_PORT=9000
DEEPGRAM_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o-mini

# ── Telephony ────────────────────────────────────────────────
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Worker ───────────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Integration Service ──────────────────────────────────────
INTEGRATION_SERVICE_PORT=8002
