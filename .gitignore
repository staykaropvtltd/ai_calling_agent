node_modules/
.next/
out/
build/
dist/
.npm/
.yarn/
*.tsbuildinfo
next-env.d.ts

# --- Docker ---
.docker/
*.log

# --- IDE & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

