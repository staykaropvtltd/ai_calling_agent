# ============================================================
# STAYKARO AI CALLER — Environment Variable Reference
# ============================================================
# Dev usage  : cp .env.example .env  →  edit values below
# Prod usage : see .env.production.example
#
# NEVER commit .env to version control.
# ============================================================

# ── Project ──────────────────────────────────────────────────
PROJECT_NAME=StaykaroAICaller
ENVIRONMENT=development
LOG_LEVEL=debug

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=staykaro
POSTGRES_USER=staykaro_user
POSTGRES_PASSWORD=change_me_in_production

# staykaro_user is the Postgres bootstrap (POSTGRES_USER) role — always a
# superuser by how the official postgres image initializes it, which means
# it unconditionally bypasses Row-Level Security (NK-07). MIGRATION_DATABASE_URL
# (superuser — runs Alembic DDL, including creating the role below) and
# DATABASE_URL (the restricted staykaro_app role — what the API actually
# serves traffic as, and the role RLS policies apply to) must stay separate.
MIGRATION_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
APP_DB_USER=staykaro_app
APP_DB_PASSWORD=change_me_in_production_too
DATABASE_URL=postgresql+psycopg://${APP_DB_USER}:${APP_DB_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# The bundled postgres container above has no SSL configured. Leave this
# false for local/docker-compose Postgres; set to true only when DATABASE_URL/
# MIGRATION_DATABASE_URL point at a TLS-requiring host such as Supabase.
DB_SSL_REQUIRED=false

# ── Redis ────────────────────────────────────────────────────
# REDIS_PASSWORD must be set in production. Leaving it empty
# means Redis runs unauthenticated — acceptable only for dev.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_LOG_LEVEL=notice
# With password:  redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ── API Service ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32

# apps/admin-dashboard and apps/client-dashboard — Next.js inlines this into
# the client bundle at build time (see each app's Dockerfile), so it must be
# set before `docker compose build`, not just before `up`. Same-origin via
# nginx's /api/ proxy (infrastructure/nginx/nginx.conf) — matches the
# default in each app's src/lib/api/client.ts. Both apps share this one var;
# they differ only in nginx path (/admin/ vs /client/), not API origin.
NEXT_PUBLIC_API_URL=http://localhost/api

# ── Internal service-to-service API ───────────────────────────
# Required by services/api's /internal/v1/* (voice gateway -> api, and as of
# Phase 6, worker -> api's job/event endpoints) and by integration-service's
# /internal/v1/process (worker -> integration-service). Empty means every
# internal request is rejected (fail closed) — use the same value across all
# of api, voice-gateway, worker, and integration-service.
INTERNAL_API_TOKEN=change_me_generate_with_openssl_rand_hex_32

# ── JWT Auth (NK-05) ─────────────────────────────────────────
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── External: Bland AI ──────────────────────────────────────
BLAND_API_KEY=

# ── Voice Gateway ────────────────────────────────────────────
VOICE_GATEWAY_HOST=0.0.0.0
VOICE_GATEWAY_PORT=9000

# Deepgram (STT)
DEEPGRAM_API_KEY=

# Groq (LLM — primary)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (LLM — fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Telephony ────────────────────────────────────────────────
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Exotel (SH-01/SH-02 — required for voice-gateway Exotel callback support)
EXOTEL_API_KEY=
EXOTEL_API_SECRET=
EXOTEL_SID=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=
EXOTEL_WEBHOOK_TOKEN=

# Internal API base URL (used by voice-gateway to reach services/api)
INTERNAL_API_URL=http://api:8000

# Set to "true" to enable the dev-only routing stub (resolves +917314623519 only)
EXOTEL_DEV_ROUTING=

# ── Worker (Phase 6) ───────────────────────────────────────────
# Reserved for a future multiple-replica concurrency model — Phase 6's
# worker is single-threaded per process (see services/worker/src/main.py's
# module docstring); not consumed yet.
WORKER_CONCURRENCY=4
# The worker reaches services/api's internal job/event API (create/claim/
# complete/fail/reap) via the same INTERNAL_API_URL already set above — job
# state itself lives only in PostgreSQL, owned by the api service; the
# worker has no database connection of its own.
# Base URL the worker uses to hand a claimed job to integration-service.
INTEGRATION_SERVICE_URL=http://integration-service:8002

# ── Integration Service (Phase 6) ───────────────────────────────
INTEGRATION_SERVICE_PORT=8002
