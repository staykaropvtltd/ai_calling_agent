# ============================================================
# STAYKARO AI CALLER — Environment Variable Reference
# ============================================================
# Dev usage  : cp .env.example .env  →  edit values below
# Prod usage : see .env.production.example
#
# NEVER commit .env to version control.
# ============================================================

# ── Project ──────────────────────────────────────────────────
PROJECT_NAME=StaykaroAICaller
ENVIRONMENT=development
LOG_LEVEL=debug

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=staykaro
POSTGRES_USER=staykaro_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ────────────────────────────────────────────────────
# REDIS_PASSWORD must be set in production. Leaving it empty
# means Redis runs unauthenticated — acceptable only for dev.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# With password:  redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ── API Service ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32

# ── JWT Auth (NK-05) ─────────────────────────────────────────
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── External: Bland AI ──────────────────────────────────────
BLAND_API_KEY=

# ── Voice Gateway ────────────────────────────────────────────
VOICE_GATEWAY_HOST=0.0.0.0
VOICE_GATEWAY_PORT=9000

# Deepgram (STT)
DEEPGRAM_API_KEY=

# Groq (LLM — primary)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (LLM — fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Telephony ────────────────────────────────────────────────
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Exotel (SH-01/SH-02 — required for voice-gateway Exotel callback support)
EXOTEL_API_KEY=
EXOTEL_API_SECRET=
EXOTEL_SID=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=
EXOTEL_WEBHOOK_TOKEN=

# Internal API base URL (used by voice-gateway to reach services/api)
INTERNAL_API_URL=http://api:8000

# Set to "true" to enable the dev-only routing stub (resolves +917314623519 only)
EXOTEL_DEV_ROUTING=

# ── Worker ───────────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Integration Service ──────────────────────────────────────
INTEGRATION_SERVICE_PORT=8002
