# ============================================
# STAYKARO AI CALLER — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
#
# Usage: cp .env.example .env
# ============================================

# --- Project ---
PROJECT_NAME=StaykaroAICaller
ENVIRONMENT=development
LOG_LEVEL=debug

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=staykaro
POSTGRES_USER=staykaro_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# --- API Service ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_SECRET_KEY=change_me_generate_a_random_key

# --- Voice Gateway ---
VOICE_GATEWAY_HOST=0.0.0.0
VOICE_GATEWAY_PORT=9000

# --- Deepgram (STT) ---
DEEPGRAM_API_KEY=

# --- Groq (LLM) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI (LLM Fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Exotel / Twilio (Telephony) ---
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
EXOTEL_API_KEY=
EXOTEL_API_SECRET=
EXOTEL_SID=

# --- Auth / JWT ---
JWT_SECRET_KEY=change_me_generate_a_random_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Worker ---
WORKER_CONCURRENCY=4

# --- Integration Service ---
INTEGRATION_SERVICE_PORT=8002

# --- n8n (optional, future use) ---
N8N_ENABLED=false
N8N_HOST=n8n
N8N_PORT=5678
N8N_PROTOCOL=http
